;;;; Run via sbcl --script, ecl -norc -shell, or CCL --no-init --batch --load.
;;;; Use fresh writable TMPDIR and XDG_CACHE_HOME directories for temporary
;;;; files and ASDF compilation. Examples run in separate Lisp processes.
(require :asdf)

(defpackage #:han-reference-check (:use #:cl))
(in-package #:han-reference-check)

(defparameter *script* (truename *load-truename*))
(defparameter *root*
  (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *script*)))

(defun load-checkout ()
  (let ((system (truename (merge-pathnames "han.asd" *root*)))
        (*compile-verbose* nil)
        (*load-verbose* nil))
    (asdf:load-asd system)
    (asdf:load-system "han")
    (unless (equal system (truename (asdf:system-source-file "han")))
      (error "ASDF selected a different checkout of Han."))))

(defun exported-names ()
  (let ((names (make-hash-table :test #'equal)))
    (dolist (package (list-all-packages))
      (when (uiop:string-prefix-p "HAN." (package-name package))
        (do-external-symbols (symbol package)
          (setf (gethash (format nil "~(~A:~A~)" (package-name package) symbol)
                         names)
                nil))))
    names))

(defun heading-name (line)
  (unless (and line (> (length line) 4)
               (uiop:string-prefix-p "# `" line)
               (char= #\` (char line (1- (length line)))))
    (error "Expected a heading of the form # `han.package:symbol`."))
  (subseq line 3 (1- (length line))))

(defun read-forms (text)
  (let ((eof (gensym)))
    (with-input-from-string (in text)
      (do ((form (read in nil eof) (read in nil eof))
           (forms nil))
          ((eq form eof) (nreverse forms))
        (push form forms)))))

(defun expectation (line)
  (dolist (entry '((:values . ";; => values ") (:primary . ";; => ") (:signals . ";; signals ")))
    (let ((prefix (cdr entry)))
      (when (uiop:string-prefix-p prefix line)
        (let ((items (read-forms (subseq line (length prefix)))))
          (unless (= 1 (length items))
            (error "Expected exactly one readable result or condition type in ~A" line))
          (when (and (eq (car entry) :values) (not (ignore-errors (list-length (first items)))))
            (error "The full set of returned values must be a proper list: ~A" line))
          (return-from expectation (values (car entry) (first items)))))))
  (error "Missing result or condition annotation at the end of the example."))

(defun check-forms (forms mode expected)
  ;; Only the last form is allowed to signal the documented condition.
  (mapc #'eval (butlast forms))
  (let ((last-form (car (last forms))))
    (ecase mode
      (:signals
       (unless (and (symbolp expected) (not (eq expected 'error)) (subtypep expected 'error))
         (error "Expected a specific named error type, got ~S." expected))
       (let ((caught (handler-case (progn (eval last-form) nil)
                       (error (condition) condition))))
         (unless caught (error "Expected ~S, but the form returned normally." expected))
         (unless (typep caught expected)
           (error "Expected ~S, got ~S: ~A" expected (type-of caught) caught))))
      ((:primary :values)
       (let* ((values (multiple-value-list (eval last-form)))
              (actual (if (eq mode :primary) (first values) values)))
         (unless (equal expected actual)
           (error "Expected ~S, got ~S (~A)." expected actual mode)))))))

(defun verify-input ()
  (let* ((*package* (find-package :cl-user))
         (*read-eval* nil)
         (lines (do ((line (read-line *standard-input* nil nil)
                           (read-line *standard-input* nil nil))
                     (result nil))
                    ((null line) (nreverse result))
                  (push line result)))
         (body (butlast lines)))
    (unless lines (error "Empty example block."))
    (when (some (lambda (line) (let ((text (string-left-trim '(#\Space #\Tab) line)))
                                 (or (uiop:string-prefix-p ";; =>" text)
                                     (uiop:string-prefix-p ";; signals" text))))
                body)
      (error "Place one expectation at the end of each block."))
    (multiple-value-bind (mode expected) (expectation (car (last lines)))
      (let ((forms (read-forms (format nil "~{~A~%~}" body))))
        (unless forms (error "Example has no Lisp forms."))
        (check-forms forms mode expected)))
    (format t "~&HAN-REFERENCE-EXAMPLE-PASSED~%")))

(defun run-example (lines)
  (with-input-from-string (in (format nil "~{~A~%~}" lines))
    (multiple-value-bind (out err status)
        (uiop:run-program
         #+sbcl (list (namestring sb-ext:*runtime-pathname*) "--noinform" "--no-sysinit"
                      "--no-userinit" "--disable-debugger" "--script" (namestring *script*) "--example")
         #+ecl (list (ext:argv 0) "-norc" "-shell" (namestring *script*) "--" "--example")
         #+ccl (list (first ccl:*command-line-argument-list*) "--no-init" "--batch" "--quiet"
                     "--load" (namestring *script*) "--" "--example")
         #-(or ccl ecl sbcl) (error "Run the reference checker under CCL, ECL or SBCL.")
         :input in :output :lines :error-output :string :ignore-error-status t)
      (unless (and (eql status 0) (equal (car (last out)) "HAN-REFERENCE-EXAMPLE-PASSED"))
        (error "Example worker exited with status ~S. ~A~%~{~A~%~}" status err out)))))

(defun page-examples (lines heading)
  (let ((start nil) (body nil) (examples nil) (line-number 0) (in-examples nil) (seen nil))
    (dolist (line lines)
      (incf line-number)
      (let* ((trimmed (string-trim '(#\Space #\Tab) line))
             (fence (or (uiop:string-prefix-p "```" trimmed)
                        (uiop:string-prefix-p "~~~" trimmed))))
        (cond
          (start
           (cond ((string= line "```")
                  (push (cons start (nreverse body)) examples)
                  (setf start nil body nil))
                 (fence (error "Unclosed Lisp block at line ~D." start))
                 (t (push line body))))
          ((string= line heading)
           (when seen (error "Duplicate Examples section at line ~D." line-number))
           (setf in-examples t seen t))
          ((uiop:string-prefix-p "## " line) (setf in-examples nil))
          ((string= line "```lisp")
           (unless in-examples (error "Lisp block outside the Examples section at line ~D." line-number))
           (setf start line-number))
          ((and in-examples fence)
           (error "Expected a lisp example fence at line ~D." line-number)))))
    (when start (error "Unclosed Lisp block at line ~D." start))
    (unless (and seen (>= (length examples) 2))
      (error "Expected at least two executable examples under ~A; found ~D." heading (length examples)))
    (nreverse examples)))

(defun section-lines (lines heading)
  (let ((section (member heading lines :test #'string=)))
    (unless section (error "Missing ~A section." heading))
    (when (member heading (rest section) :test #'string=)
      (error "Duplicate ~A section." heading))
    (let* ((body (loop for line in (rest section)
                       until (uiop:string-prefix-p "## " line) collect line))
           (content (string-trim '(#\Space #\Tab #\Newline) (format nil "~{~A~%~}" body))))
      (when (zerop (length content)) (error "Empty ~A section." heading))
      (uiop:split-string content :separator '(#\Newline)))))

(defun read-indexes (reference files)
  (loop for name in files
        for file = (merge-pathnames name reference)
        collect (cons file (uiop:read-file-string file :external-format :utf-8))))

(defun read-page (file reference indexes counterpart syntax description examples)
  (handler-case
      (let* ((lines (uiop:read-file-lines file :external-format :utf-8))
             (link (format nil "](~A)" (enough-namestring file reference)))
             (language-link (format nil "](~A)" (file-namestring counterpart)))
             (signature (section-lines lines syntax)))
        (dolist (index indexes)
          (unless (search link (cdr index))
            (error "Missing link ~A in ~A." link (car index))))
        (unless (some (lambda (line) (search language-link line)) lines)
          (error "Missing link to the other language: ~A." language-link))
        (unless (and (>= (length signature) 3)
                     (string= (first signature) "```text")
                     (string= (car (last signature)) "```"))
          (error "Expected a fenced signature under ~A." syntax))
        (section-lines lines description)
        (values (heading-name (first lines)) signature (page-examples lines examples)))
    (error (condition) (error "~A: ~A" file condition))))

(defun check-page-pair (english chinese reference english-indexes chinese-indexes names)
  (multiple-value-bind (name signature examples)
      (read-page english reference english-indexes chinese "## Syntax" "## Description" "## Examples")
    (multiple-value-bind (other-name other-signature other-examples)
        (read-page chinese reference chinese-indexes english "## 语法" "## 说明" "## 示例")
      (unless (equal name other-name)
        (error "~A documents ~A; ~A documents ~A." english name chinese other-name))
      (unless (equal signature other-signature)
        (error "Signatures differ in ~A and ~A." english chinese))
      (unless (= (length examples) (length other-examples))
        (error "Example counts differ in ~A and ~A." english chinese))
      (loop for (line . body) in examples
            for (other-line . other-body) in other-examples
            unless (equal body other-body)
              do (error "Example or expectation differs at ~A:~D and ~A:~D."
                        english line chinese other-line)))
    (multiple-value-bind (earlier exported-p) (gethash name names)
      (unless exported-p (error "No public symbol named ~A in ~A." name english))
      (when earlier (error "~A is documented in both ~A and ~A." name earlier english))
      (setf (gethash name names) english))
    examples))

(defun check-reference ()
  (let* ((reference (merge-pathnames "docs/reference/" *root*))
         (names (exported-names))
         (english-indexes (read-indexes reference '("README.md" "symbols.md")))
         (chinese-indexes (read-indexes reference '("README.zh-CN.md" "symbols.zh-CN.md")))
         (suffix ".zh-CN")
         (pages nil)
         (count 0))
    (when (zerop (hash-table-count names)) (error "Han exported no symbols."))
    (dolist (file (directory (merge-pathnames "*/*.md" reference)))
      (let ((stem (pathname-name file)))
        (if (uiop:string-suffix-p stem suffix)
            (unless (probe-file (make-pathname :name (subseq stem 0 (- (length stem) (length suffix)))
                                               :defaults file))
              (error "Missing English page for ~A." file))
            (let* ((chinese (make-pathname :name (concatenate 'string stem suffix) :defaults file))
                   (examples (check-page-pair file chinese reference english-indexes chinese-indexes names)))
              (push (cons file examples) pages)))))
    (maphash (lambda (name file)
               (unless file (error "~A is missing a page for ~A." reference name)))
             names)
    (dolist (page (nreverse pages))
      (loop for (line . body) in (cdr page)
            for index from 1
            do (handler-case (run-example body)
                 (error (condition)
                   (error "~A: example ~D at line ~D: ~A" (car page) index line condition)))
               (incf count)))
    (format t "~&Validated ~D public symbols (~D reference pages) and ran ~D matching examples.~%"
            (hash-table-count names) (* 2 (hash-table-count names)) count)))

(handler-case
    (uiop:with-current-directory (*root*)
      (load-checkout)
      (cond ((null (uiop:command-line-arguments)) (check-reference))
            ((equal (uiop:command-line-arguments) '("--example")) (verify-input))
            (t (error "Unexpected script arguments.")))
      #+ccl (uiop:quit 0))
  (error (condition)
    (format *error-output* "~&Reference check failed: ~A~%" condition)
    (uiop:quit 1)))
