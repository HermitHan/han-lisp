(in-package :cl-user)

(defun cli-probe-main ()
  (han.host:prepare-runtime-io)
  (han.host::%with-cli-error-boundary ("[HAN-PROBE]")
    (han.host:configure-runtime-io)
    (let ((mode (han.host:getenv "HAN_CLI_CASE")))
      (cond ((equal mode "success") (write-string "result"))
            ((equal mode "explicit-status") (han.host:quit 7))
            ((member mode '("flush-success" "flush-failure") :test #'equal)
             ;; Resolve the synonym only when QUIT flushes the stream.
             (let ((*standard-output* (make-synonym-stream (gensym "MISSING-OUTPUT-"))))
               (han.host:quit (if (equal mode "flush-success") 0 7))))
            ((equal mode "required-stderr")
             (write-line "required diagnostic" *error-output*)
             (finish-output *error-output*))
            ((member mode '("optional-progress" "partial-progress" "partial-progress-failure")
                     :test #'equal)
             (ignore-errors
               (write-string "progress" *error-output*)
               (when (equal mode "optional-progress") (terpri *error-output*))
               (finish-output *error-output*))
             (write-line "result")
             (when (equal mode "partial-progress-failure") (han.host:quit 7)))
            ((member mode '("late-close" "late-close-failure") :test #'equal)
             (write-string "sent")
             (finish-output)
             (read-char)
             (han.host:quit (if (equal mode "late-close") 0 7)))
            ((equal mode "error") (error "expected failure"))
            ((equal mode "interrupt")
             (write-line "ready")
             (finish-output)
             (read-char)
             (error "unexpected input"))
            (t (error "Unknown probe case ~S" mode))))
    (han.host:quit 0)))
